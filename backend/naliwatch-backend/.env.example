ENV=dev
DATABASE_URL=postgresql+psycopg://naliwatch:naliwatch@localhost:5432/naliwatch
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string
# Dev only: return the OTP in the API response instead of only sending it
OTP_DEV_ECHO=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Claude (report classification)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
AI_DAILY_CALL_CAP=2000

# Speech to text: whisper | bhashini | none
STT_PROVIDER=none
OPENAI_API_KEY=

# Telegram (hackathon demo)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me

# WhatsApp Cloud API (pilot)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=

# SMS gateway (generic JSON webhook; DLT registration needed for India)
SMS_WEBHOOK_URL=

# Storage: leave S3_BUCKET empty to use ./media locally
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
MEDIA_DIR=./media

# Routing
OSRM_URL=https://router.project-osrm.org

# ---- Open decisions from the plan (placeholders, set with the team) ----
VOLUME_TOLERANCE_PCT=10
VOLUME_TOLERANCE_MIN_LITRES=100
FILL_LIMIT=0.33
SLUDGE_LITRES_PER_PERSON_DAY=0.15
MANUAL_CLEANING_RESPONDER_PHONE=
GPS_PING_INTERVAL_SECONDS=30
GPS_GAP_MINUTES=10
RETENTION_PHOTO_DAYS=180
RETENTION_GPS_DAYS=90
